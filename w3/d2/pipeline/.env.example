# AIOps Pipeline Configuration
# Copy this file to .env and fill in your actual values

# LLM Configuration (required for LLM enrichment in RCA)
GROQ_API_KEY=your_groq_api_key_here

# Pipeline Configuration
AIOPS_VERSION=1.0.0
AIOPS_USE_LLM=true
AIOPS_LLM_MODEL=llama-3.3-70b-versatile
AIOPS_CORRELATE_GAP_SEC=120
AIOPS_CORRELATE_MAX_HOP=2
AIOPS_GRAPH_RELOAD_SEC=300

# Dataset Paths (relative to /app in container)
AIOPS_SERVICES_JSON=/app/dataset/services.json
AIOPS_HISTORY_JSON=/app/dataset/incidents_history.json
